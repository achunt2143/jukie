# Local dev-only holding area (legacy cruft, build artifacts, and anything sensitive
# pulled out of the shipped app/service dirs during GitHub prep) - never published.
dev-stuff/

# Built webOS package (regenerated fresh by deploy-jukie.ps1 on every run)
*.ipk

# Secrets and the compiled DRM helper(s) bundled into the service at deploy time - these
# MUST stay physically present in webOS-legacy/com.achunt.jukie.service/ for
# deploy-jukie.ps1 to package them, but must never be committed. Named per webOS version
# now (jukie-drm-webos2/-webos3, not the old single "jukie-drm") since the service ships
# both and picks one at load time.
webOS-legacy/com.achunt.jukie.service/device.wvd
webOS-legacy/com.achunt.jukie.service/secrets.local.json
webOS-legacy/com.achunt.jukie.service/jukie-drm-webos2
webOS-legacy/com.achunt.jukie.service/jukie-drm-android-arm64
webOS-legacy/com.achunt.jukie.service/jukie-drm-webos3

# Any *.local.* file, anywhere - this project's own convention for real secrets that must
# stay on-device only (e.g. source/dev-token.local.js holds a real Apple developer token +
# music user token). This is git-side enforcement only - palm-package ignores .gitignore
# and build-ignore; deploy-jukie.ps1 excludes *.local.js at package time and runs
# check-ipk-secrets.py on the finished .ipk.
*.local.*

# Claude Code local session settings (personal permission/command history, not project source)
.claude/settings.local.json

# OS/editor cruft
.DS_Store
Thumbs.db

# Python bytecode (from the packaging helper scripts)
__pycache__/
*.pyc
