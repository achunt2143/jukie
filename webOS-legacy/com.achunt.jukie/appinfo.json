{
	"id": "com.achunt.jukie",
	"version": "2.0.0",
	"vendor": "achunt",
	"type": "web",
	"main": "index.html",
	"title": "Jukie",
	"keywords": ["Apple Music", "Music", "Audio", "Songs"],
	"icon": "icon.png",
	"splashicon": "icon-256x256.png",
	"miniicon": "enyo/images/notification-small.png",
	"theme": "palm-dark",
	"noWindow": true,
	"dockMode": true,
	"touchstoneMode": "enabled",
	"uiRevision": 2,
	"debug": false,
	"removable": false,
	"universalSearch": {
		"dbsearch": {
			"displayName": "Your Library",
			"url": "com.achunt.jukie",
			"launchParam": "libItemId",
			"launchParamDbField": "_id",
			"displayFields": ["name", "artistName"],
			"dbQuery": {
				"from": "com.achunt.jukie.libitem:1",
				"where": [{"prop": "sortName", "op": "?", "val": "", "collate": "primary"}],
				"orderBy": "sortName",
				"limit": 20
			}
		}
	}
}
